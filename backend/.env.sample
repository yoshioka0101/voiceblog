PORT=8080
LOG_LEVEL=info
POSTGRES_PORT=5433
POSTGRES_USER=voiceblog
POSTGRES_PASSWORD=voiceblog-local-password
POSTGRES_DB=voiceblog
GOOGLE_CLIENT_ID=your-google-client-id-here
# Optional. Future LLM integrations such as Gemini must be configured on backend only.
# Issue the credential when the feature that actually calls Gemini is implemented.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=
# 64-char hex string (32 bytes) for AES-256-GCM encryption of external API tokens
TOKEN_ENCRYPTION_KEY=
# AI 記事生成（POST /articles/generate）の 1 日あたりの上限。UTC の日付で区切る。0 は無制限。
GENERATE_DAILY_LIMIT_PER_USER=20
GENERATE_DAILY_LIMIT_GLOBAL=300
